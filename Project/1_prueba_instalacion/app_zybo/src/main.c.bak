#include <stdio.h>
#include "xil_printf.h"
#include "xgpio.h"
#include "xparameters.h"
#include "xil_io.h"

// Usamos la dirección base definida en tu hardware
#define GPIO_BASE_ADDR      XPAR_AXI_GPIO_0_BASEADDR
#define SWITCH_CHANNEL      1

XGpio Gpio;

int main()
{
    int Status;
    u32 sw_val_1 = 0;
    u32 sw_val_2 = 0;
    u32 result = 0;
    char input_char;

    // Configuración moderna de GPIO
    XGpio_Config GpioConfig;
    GpioConfig.BaseAddress = GPIO_BASE_ADDR;
    GpioConfig.InterruptPresent = 0; // Desactivamos interrupciones para esta prueba
    GpioConfig.IsDual = 0;

    Status = XGpio_CfgInitialize(&Gpio, &GpioConfig, GpioConfig.BaseAddress);
    if (Status != XST_SUCCESS) {
        xil_printf("Fallo al iniciar GPIO\n\r");
        return XST_FAILURE;
    }

    // Configurar los 4 switches como entrada (0xF)
    XGpio_SetDataDirection(&Gpio, SWITCH_CHANNEL, 0xF);

    xil_printf("\n\r======================================\n\r");
    xil_printf("   Programa de Prueba Zybo (Legacy)   \n\r");
    xil_printf("======================================\n\r");
    xil_printf("Prueba la logica en la placa: Pulsa BTN0-BTN3 para encender LD0-LD3.\n\r");

    while(1) {
        xil_printf("\n\rEscoge el PRIMER numero con los switches (SW0-SW3) y pulsa INTRO: ");
        
        while(1) {
            input_char = inbyte();
            if(input_char == '\r' || input_char == '\n') break; 
        }

        sw_val_1 = XGpio_DiscreteRead(&Gpio, SWITCH_CHANNEL);
        xil_printf("\n\rNumero 1 leido: %d", sw_val_1);

        xil_printf("\n\rEscoge el SEGUNDO numero con los switches y pulsa INTRO: ");
        
        while(1) {
            input_char = inbyte();
            if(input_char == '\r' || input_char == '\n') break;
        }

        sw_val_2 = XGpio_DiscreteRead(&Gpio, SWITCH_CHANNEL);
        xil_printf("\n\rNumero 2 leido: %d", sw_val_2);

        result = sw_val_1 + sw_val_2;
        xil_printf("\n\r------------------------------");
        xil_printf("\n\rRESULTADO: %d + %d = %d", sw_val_1, sw_val_2, result);
        xil_printf("\n\r------------------------------\n\r");
    }

    return 0;
}